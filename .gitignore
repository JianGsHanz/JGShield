# ---- Python ----
__pycache__/
*.pyc
*.pyo

# ---- Build / dist artifacts (regenerable) ----
_build_venv/
_noop_sc/
build/
dist/
output/

# ---- Temp & scratch ----
temp/
work/
_wk/
_batch_b2.txt
test_repack.py

# ---- Test samples (regenerable via gen_samples.py) ----
test_apks/
gen_samples/

# ---- External tool binaries (not source; place locally to run harden.py) ----
tools/
# libjgguard.so 是加固壳强依赖的 native 产物，必须与 jg_guard.c 同步，强制入库
!tools/libjgguard/
!tools/libjgguard/*.so
# obf.dex 是 --dex-obf 功能强依赖的解密器，由源码 src/java/com/jiagu/obf/ObfStr.java 编译。
# 因 tools/ 整目录被忽略，用 `git add -f tools/obf.dex` 强制入库（与 libjgguard.so 同等强依赖）。

# ---- Keystores (never commit keys) ----
*.jks
*.keystore

# ---- WorkBuddy project data ----
.workbuddy/

# ---- OS junk ----
Thumbs.db
Desktop.ini
ehthumbs.db
.DS_Store

# ===== 验证 / 调试临时产物（本轮新增，不入库） =====
# frida 验证目录：保留驱动脚本（driver_*.py），忽略 53MB 二进制与运行日志
_frida/frida-server
_frida/*.xz
_frida/*_712.txt
_frida/*.txt
# <26 边界验证产物目录（可由 verify_lt26.py 重建）
_lt26_verify/
# Windows 设备名误生成文件（无法常规删除，忽略即可）
nul
# 杂项日志
stub_build.log
verify_run.log
verify_stderr.txt
verify_stdout.txt

# ===== 构建中间产物（可重建，不入库） =====
_stubout/
_stub_classes.jar

# ===== 验证/调试辅助（保留本地，不入库） =====
_ref/
_frida/
androguard.db
androguard.db-shm
androguard.db-wal
_ollvm_*
_probe/
_diag_*.py
_verify_exe.py

# ===== OLLVM 远程构建（大件与临时，不入库） =====
_*.log
_*.txt
_nofla.*
android-ndk-*.zip
llvm-project-llvmorg-*/
ollvm-14/
